<div onclick="document.location='https://discord.com/users/{{config.discordId}}'" class="cursor-pointer flex items-center space-x-4 justify-center">
    <div class="relative">
        <img class="rounded-full w-16 h-16" src="{{user.avatar}}" alt="Avatar">
        <img class="absolute top-0 left-0 z-3 w-16 h-16" src="{{user.decoration}}">
        <div class="absolute bottom-0 right-0 w-4 h-4 rounded-full border-2 border-[#1e1e2e] z-10" style="background-color: {{user.status}};"></div>
    </div>
    <div class="flex flex-col items-center">
        <h1 class="text-2xl font-bold text-center {{#if config.particles}}bg-[url('/particles/{{config.particlesColor}}.gif')]{{/if}}">{{user.displayName}}</h1>
        <a class="text-sm text-center">@{{user.username}}</a>
    </div>
</div>