    </div>

    <div id="activity-fallback" class="hidden w-full text-center">
        <span class="text-xs opacity-60">Odpoczywam! :)</span>
    </div>

    <div id="activity-content" class="flex items-center space-x-4 w-full">
        <div class="relative w-16 h-16 flex-shrink-0">
            <img id="activity-large-image" class="hidden w-16 h-16 rounded-xl object-cover"
                 src="{{user.activity.assets.large_image_url}}"
                 alt="{{user.activity.name}}">
            <img id="activity-small-image" class="hidden absolute -bottom-1 -right-1 w-6 h-6 rounded-full border-2 border-[#1e1e2e] hidden"
                 src="{{user.activity.assets.small_image_url}}">
        </div>

        <div class="flex flex-col flex-1 text-left justify-center overflow-hidden">
            <span id="activity-name" class="font-bold text-sm truncate" style="color: {{config.fontColor}}"></span>

            <span id="activity-details" class="text-xs truncate opacity-80 mt-0.5" style="color: {{config.fontColor}}"></span>
            <span id="activity-state" class="text-xs truncate opacity-80 mt-0.5" style="color: {{config.fontColor}}"></span>

            <span id="activity-timer" class="text-xs font-mono truncate opacity-60 mt-1" style="color: {{config.fontColor}}"></span>
        </div>
    </div>
</div>

<script>
    let activityData = null;

    async function fetchActivity() {
        try {
            const response = await fetch('/api/activity');
            const data = await response.json();

            if (!data || !data.id) activityData = null;
            else activityData = data;

            updateActivityUI(data);
        } catch (err) {
            activityData = null;
            console.error("Błąd pobierania aktywności:", err);
            updateActivityUI(null);
        }
    }

    function updateActivityUI(data) {
        const container = document.getElementById('activity-container');
        const content = document.getElementById('activity-content');
        const fallback = document.getElementById('activity-fallback');
        const largeImg = document.getElementById('activity-large-image');
        const smallImg = document.getElementById('activity-small-image');
        const name = document.getElementById('activity-name');
        const details = document.getElementById('activity-details');
        const state = document.getElementById('activity-state');

        if (!data || !data.id) {
            content.classList.add('hidden');
            fallback.classList.remove('hidden');
            return;
        }

        content.classList.remove('hidden');
        fallback.classList.add('hidden');

        if (data.assets && data.assets.large_image_url) {
            largeImg.src = data.assets.large_image_url;
            largeImg.classList.remove('hidden');
            largeImg.style.display = 'block';
        } else {
            largeImg.classList.add('hidden');
            largeImg.style.display = 'none';
        }

        if (data.assets && data.assets.small_image_url) {
            smallImg.src = data.assets.small_image_url;
            smallImg.classList.remove('hidden');
        } else {
            smallImg.classList.add('hidden');
        }

        name.textContent = data.name || "Spotify";
        if (details) details.textContent = data.details || "";
        if (state) state.textContent = data.state || "";
    }

    function updateTimer() {
        const timerEl = document.getElementById("activity-timer");
        if (!timerEl) return;

        if (!activityData || !activityData.timestamps) {
            timerEl.textContent = "";
            return;
        }

        const now = Date.now();
        const start = activityData.timestamps.start;
        const end = activityData.timestamps.end;

        let diff = 0;
        let prefix = "";

        if (end) {
            diff = Math.max(0, Math.floor((end - now) / 1000));
            prefix = "Pozostało ";
        } else if (start) {
            diff = Math.max(0, Math.floor((now - start) / 1000));
            prefix = "Upłynęło ";
        }

        const h = Math.floor(diff / 3600);
        const m = Math.floor((diff % 3600) / 60);
        const s = diff % 60;

        const formattedTime = h > 0
                ? `${h}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`
                : `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;

        timerEl.textContent = prefix + formattedTime;
    }

    fetchActivity();
    setInterval(fetchActivity, 5000);
    setInterval(updateTimer, 1000);
</script>